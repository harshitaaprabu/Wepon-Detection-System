# === Virtual environments ===
venv/
env/
ENV/
.venv/

# === Python ===
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
.eggs/

# === Django ===
# Local settings / secrets
.env
*.env
!*.env.example

# Database
db.sqlite3
db.sqlite3-journal

# Collected static files (regenerated by `collectstatic`)
Server Side/wd_s/staticfiles/

# User-uploaded / runtime-generated media (MEDIA_ROOT)
Server Side/wd_s/static/images/*
!Server Side/wd_s/static/images/.gitkeep

# === Client Side runtime / model files ===
# Captured frames written at runtime
Client Side/save_frame/*
!Client Side/save_frame/.gitkeep

# YOLO weights are large binaries (100MB+) — GitHub blocks files over 100MB.
# Download separately and place here (see README) instead of committing.
Client Side/weights/*.weights
!Client Side/weights/.gitkeep

# === OS / editor junk ===
.DS_Store
Thumbs.db
.idea/
.vscode/
*.log
